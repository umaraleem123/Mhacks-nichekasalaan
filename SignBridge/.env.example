# Copy this file to .env and fill in your own keys.
#
#   macOS:   cp .env.example .env
#   Windows: Copy-Item .env.example .env
#
# .env is gitignored. Never commit a real key.

# ElevenLabs text-to-speech.
# Create a key at https://elevenlabs.io/
# Use a voice ID from My Voices in the ElevenLabs dashboard.
ELEVENLABS_API_KEY=your-key-here
ELEVENLABS_VOICE_ID=rWZM1pGWKmpGt3Hvergd

# Conservative live demo (default). Fewer wrong words beats more predictions.
SIGNBRIDGE_DEMO_MODE=true

# Optional overrides. Demo mode uses 0.80 when this is unset.
# SIGNBRIDGE_CONFIDENCE_THRESHOLD=0.80

# Optional: left/right hand mirror copies of training sequences only
# (default on). Does not write extra files and does not change the webcam.
SIGNBRIDGE_MIRROR_AUGMENTATION=true

# Max recording length for the sequence collector (seconds).
# SIGNBRIDGE_SEQUENCE_SECONDS=5.0
