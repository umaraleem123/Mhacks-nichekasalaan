# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Testing and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment / secrets
.env
.env.*
# The committed template holds no real key.
!.env.example

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Trained models and large artifacts (keep the directories themselves)
models/*
!models/.gitkeep
models/asl_sequence_model.pt
models/asl_sequence_labels.json

# Hugging Face pretrained checkpoint + label map (unused live path; downloaded on demand)
models/pretrained/
models/pretrained/**
!models/pretrained/.gitkeep

# Captured/recorded datasets
data/*
!data/.gitkeep
data/sequences/

# Large media in assets/ (small reference images stay tracked)
assets/**/*.mp4
assets/**/*.mov
assets/**/*.avi
assets/**/*.webm

# Temporary encoded sentence clips must never be committed. The recognizer
# writes them under tempfile and deletes them; this is a backstop.
*.mp4
*.mov
*.avi
*.webm
